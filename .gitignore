# Node dependencies — restored via `bun install`
node_modules/

# Large source/derived data files (hundreds of MB) — regenerate, don't commit.
# Per-county NDJSON caches from the ArcGIS services, and the derived SQLite DB.
data/

# SQLite write-ahead-log / shared-memory sidecar files
*.db-wal
*.db-shm

# Local environment secrets (none needed today, kept for safety)
.env
.env.local
.env.*.local

# macOS Finder metadata
.DS_Store

# Agent scratchpad — ephemeral task notes, never shared (INFRA-161)
.agent/scratchpad.md
